FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    make \
    curl \
    shellcheck \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Trivy
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/v0.58.2/contrib/install.sh -o install.sh && \
    echo "2304dcc0c1883e802d376eae1b514c923b7427a7d88091dfcaf83967e6f55a7c  install.sh" | sha256sum --check && \
    sh install.sh -b /usr/local/bin && \
    rm install.sh

WORKDIR /work

# Copy requirements and install Python dependencies
COPY requirements-dev.txt .
RUN pip install --no-cache-dir --require-hashes -r requirements-dev.txt

# Copy Ansible requirements and install collections globally
COPY deploy/requirements.yml ./deploy/
RUN mkdir -p /usr/share/ansible/collections && \
    ansible-galaxy collection install -p /usr/share/ansible/collections -r deploy/requirements.yml

# Bypass git "dubious ownership" error for volume mounts (system-wide)
RUN git config --system --add safe.directory '*'

# Entrypoint is bash to allow make to drive it
ENTRYPOINT ["/bin/bash"]
